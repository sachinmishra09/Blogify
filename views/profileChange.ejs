<img src="<%= user.profileImageURL %>" width="100" class="rounded-circle mb-2">

<form action="/user/profile-image" method="POST" enctype="multipart/form-data">
    <input type="file" name="profileImage" class="form-control mb-2" required>
    <button type="submit" class="btn btn-primary">Update Profile Picture</button>
</form>