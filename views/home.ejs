<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head.ejs') %>

    <title>Blogify - Home</title>

    <style>
        body {
            background-color: rgb(146, 146, 146);
        }

        /* =========================
           Landing Page
        ========================= */

        .hero-section {
            min-height: calc(100vh - 70px);
            display: flex;
            align-items: center;
            padding: 70px 0;
            background:
                linear-gradient(
                    135deg,
                    #f8f9fa 0%,
                    #e9ecef 100%
                );
        }

        .hero-title {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            font-weight: 800;
            line-height: 1.1;
        }

        .hero-title span {
            color: #0d6efd;
        }

        .hero-text {
            font-size: 1.15rem;
            line-height: 1.7;
            color: #6c757d;
            max-width: 600px;
        }

        .hero-buttons .btn {
            padding: 12px 25px;
            border-radius: 8px;
        }

        .hero-image {
            width: 100%;
            max-width: 500px;
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
        }

        /* =========================
           Features
        ========================= */

        .feature-section {
            padding: 80px 0;
            background-color: white;
        }

        .feature-card {
            height: 100%;
            padding: 30px;
            border: none;
            border-radius: 15px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .feature-icon {
            width: 55px;
            height: 55px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background-color: #e7f1ff;
            font-size: 25px;
            margin-bottom: 20px;
        }

        /* =========================
           CTA
        ========================= */

        .cta-section {
            padding: 80px 0;
        }

        .cta-box {
            padding: 60px 30px;
            border-radius: 20px;
            background-color: #0d6efd;
            color: white;
        }

        .cta-box p {
            color: rgba(255, 255, 255, 0.85);
        }

        /* =========================
           Blog Cards
        ========================= */

        .blog-card {
            border-radius: 15px;
            overflow: hidden;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .blog-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12) !important;
        }

        .blog-image {
            width: 100%;
            height: 210px;
            object-fit: cover;
        }

        .blog-title {
            font-size: 1.2rem;
            line-height: 1.4;
        }

        .author-image {
            width: 32px;
            height: 32px;
            object-fit: cover;
        }

        .action-buttons {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 10;
        }

        .action-buttons .btn {
            width: 35px;
            height: 35px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .read-more {
            border-radius: 8px;
        }

        .page-heading {
            font-weight: 700;
        }

        .page-subtitle {
            color: #6c757d;
        }

        @media (max-width: 768px) {
            .hero-section {
                padding: 50px 0;
                text-align: center;
            }

            .hero-text {
                margin: 0 auto;
            }

            .hero-image {
                margin-top: 50px;
            }

            .hero-buttons {
                justify-content: center;
            }
        }
    </style>
</head>

<body>

    <%- include('./partials/nav.ejs') %>


    <!-- =====================================================
         LOGGED IN USER
    ====================================================== -->

    <% if (locals.user) { %>

        <!-- Page Header -->
        <div class="container mt-5">

            <div class="text-center mb-5">

                <h1 class="page-heading">
                    Discover Stories
                </h1>

                <p class="page-subtitle mb-0">
                    Read, share and explore interesting blogs.
                </p>

            </div>


            <!-- Blog Grid -->
            <div class="row g-4">

                <% blogs.forEach(blog => { %>

                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                        <div class="card blog-card h-100 border-0 shadow-sm position-relative">

                            <!-- Edit/Delete -->
                            <% if (
                                user._id.toString() ===
                                blog.createdBy._id.toString()
                            ) { %>

                                <div class="action-buttons d-flex gap-2">

                                    <!-- Edit -->
                                    <a
                                        href="/blog/edit/<%= blog._id %>"
                                        class="btn btn-light shadow-sm"
                                        title="Edit"
                                    >
                                        ✏️
                                    </a>

                                    <!-- Delete -->
                                    <form
                                        action="/blog/delete/<%= blog._id %>"
                                        method="POST"
                                        class="m-0"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-light shadow-sm"
                                            title="Delete"
                                            onclick="return confirm('Are you sure you want to delete this blog?')"
                                        >
                                            ❌
                                        </button>

                                    </form>

                                </div>

                            <% } %>


                            <!-- Blog Image -->
                            <img
                                src="<%= blog.coverImageURL %>"
                                class="card-img-top blog-image"
                                alt="<%= blog.title %>"
                            >


                            <!-- Card Body -->
                            <div class="card-body d-flex flex-column">

                                <h5 class="card-title blog-title fw-bold mb-3">
                                    <%= blog.title %>
                                </h5>


                                <!-- Author -->
                                <div class="d-flex align-items-center gap-2 mb-3 mt-2">

                                    <img
                                        src="<%= blog.createdBy.profileImageURL %>"
                                        alt="<%= blog.createdBy.fullName %>"
                                        class="rounded-circle author-image"
                                    >

                                    <small class="text-muted">
                                        <%= blog.createdBy.fullName %>
                                    </small>

                                </div>


                                <!-- Read More -->
                                <a
                                    href="/blog/<%= blog._id %>"
                                    class="btn btn-primary w-100 mt-auto read-more"
                                >
                                    Read More →
                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>


            <!-- Empty State -->
            <% if (blogs.length === 0) { %>

                <div class="text-center py-5">

                    <h4 class="text-muted">
                        No blogs yet
                    </h4>

                    <p class="text-muted">
                        Be the first person to create a blog!
                    </p>

                    <a
                        href="/blog/add-new"
                        class="btn btn-primary"
                    >
                        Create Blog
                    </a>

                </div>

            <% } %>

        </div>


    <!-- =====================================================
         LOGGED OUT USER
    ====================================================== -->

    <% } else { %>


        <!-- Hero Section -->
        <section class="hero-section">

            <div class="container">

                <div class="row align-items-center">

                    <!-- Hero Content -->
                    <div class="col-lg-6">

                        <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-3">
                            ✨ Welcome to Blogify
                        </span>

                        <h1 class="hero-title mt-3">
                            Share your
                            <span>ideas.</span>
                            <br>
                            Inspire the world.
                        </h1>

                        <p class="hero-text mt-4">
                            Blogify is a simple place to write, discover,
                            and share stories that matter to you.
                            Turn your ideas into meaningful conversations.
                        </p>


                        <!-- Buttons -->
                        <div class="hero-buttons d-flex flex-wrap gap-3 mt-4">

                            <a
                                href="/user/signup"
                                class="btn btn-primary"
                            >
                                Start Writing ✍️
                            </a>

                            <a
                                href="/user/signin"
                                class="btn btn-outline-dark"
                            >
                                Sign In
                            </a>

                        </div>

                    </div>


                    <!-- Hero Image -->
                    <div class="col-lg-6 text-center">

                        <img
                            src="https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=900&q=80"
                            alt="Writing a blog"
                            class="hero-image"
                        >

                    </div>

                </div>

            </div>

        </section>


        <!-- Features -->
        <section class="feature-section">

            <div class="container">

                <div class="text-center mb-5">

                    <h2 class="fw-bold">
                        Everything you need to blog
                    </h2>

                    <p class="text-muted">
                        A simple platform built for people who love sharing ideas.
                    </p>

                </div>


                <div class="row g-4">

                    <!-- Feature 1 -->
                    <div class="col-md-4">

                        <div class="card feature-card shadow-sm">

                            <div class="feature-icon">
                                ✍️
                            </div>

                            <h4 class="fw-bold">
                                Write
                            </h4>

                            <p class="text-muted mb-0">
                                Create beautiful blog posts and share
                                your thoughts, experiences, and knowledge
                                with the world.
                            </p>

                        </div>

                    </div>


                    <!-- Feature 2 -->
                    <div class="col-md-4">

                        <div class="card feature-card shadow-sm">

                            <div class="feature-icon">
                                📖
                            </div>

                            <h4 class="fw-bold">
                                Discover
                            </h4>

                            <p class="text-muted mb-0">
                                Explore interesting stories from different
                                people and discover new ideas every day.
                            </p>

                        </div>

                    </div>


                    <!-- Feature 3 -->
                    <div class="col-md-4">

                        <div class="card feature-card shadow-sm">

                            <div class="feature-icon">
                                💬
                            </div>

                            <h4 class="fw-bold">
                                Connect
                            </h4>

                            <p class="text-muted mb-0">
                                Join conversations, leave comments, and
                                connect with people through their stories.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- Call To Action -->
        <section class="cta-section">

            <div class="container">

                <div class="cta-box text-center shadow">

                    <h2 class="fw-bold">
                        Have a story to tell?
                    </h2>

                    <p class="mt-3">
                        Create your free account and start sharing
                        your ideas with the Blogify community.
                    </p>

                    <a
                        href="/user/signup"
                        class="btn btn-light btn-lg mt-3 px-4"
                    >
                        Create Your Account
                    </a>

                </div>

            </div>

        </section>


    <% } %>


    <%- include('./partials/script.ejs') %>

</body>

</html>