<nav class="navbar navbar-expand-lg bg-dark navbar-dark shadow-sm">
    <div class="container-fluid">

        <!-- Brand -->
        <a class="navbar-brand fw-bold" href="/">
            Blogify
        </a>

        <!-- Mobile Toggle -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavDropdown"
            aria-controls="navbarNavDropdown"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>


        <div class="collapse navbar-collapse" id="navbarNavDropdown">

            <!-- Left Navigation -->
            <ul class="navbar-nav">

                <li class="nav-item">
                    <a class="nav-link" href="/">
                        Home
                    </a>
                </li>

                <% if (locals.user) { %>

                    <li class="nav-item">
                        <a class="nav-link" href="/blog/add-new">
                            Add Blog
                        </a>
                    </li>

                <% } else { %>

                    <li class="nav-item">
                        <a class="nav-link" href="/user/signup">
                            Create Account
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/user/signin">
                            Sign in
                        </a>
                    </li>

                <% } %>

            </ul>


            <!-- Right Side -->
            <% if (locals.user) { %>

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item dropdown">

                        <!-- Profile Image -->
                        <a
                            class="nav-link dropdown-toggle d-flex align-items-center"
                            href="#"
                            role="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >

                            <img
                                src="<%= user.profileImageURL %>"
                                alt="<%= user.fullName %>"
                                class="rounded-circle profile-navbar-image"
                            >

                        </a>


                        <!-- Dropdown -->
                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <!-- User Name -->
                            <li>
                                <h6 class="dropdown-header">
                                    <%= user.fullName %>
                                </h6>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <!-- Change Profile Image -->
                            <li>
                                <a
                                    class="dropdown-item"
                                    href="/user/profile-image"
                                >
                                    🖼️ Change Profile Image
                                </a>
                            </li>

                            <!-- Logout -->
                            <li>
                                <a
                                    class="dropdown-item text-danger"
                                    href="/user/logout"
                                >
                                    🚪 Logout
                                </a>
                            </li>

                        </ul>

                    </li>

                </ul>

            <% } %>

        </div>
    </div>
</nav>


<!-- Error Message -->
<% if (locals.error) { %>

    <div class="container mt-4">

        <div
            class="alert alert-danger alert-dismissible fade show"
            role="alert"
        >
            <%= locals.error %>

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"
            ></button>

        </div>

    </div>

<% } %>


<style>
    .profile-navbar-image {
        width: 38px;
        height: 38px;
        object-fit: cover;
        border: 2px solid rgba(255, 255, 255, 0.7);
    }

    .profile-navbar-image:hover {
        border-color: white;
    }

    .dropdown-menu {
        min-width: 220px;
        border-radius: 10px;
    }
</style>