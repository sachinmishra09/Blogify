<!DOCTYPE html>
<html lang="en">

<head>

    <%- include('./partials/head.ejs') %>

        <title>
            <%= blog.title %>
        </title>

        <style>
            body {
                background-color: #f8f9fa;
            }

            /* Main blog container */
            .blog-container {
                max-width: 900px;
            }

            /* Blog title */
            .blog-title {
                font-size: clamp(1.8rem, 4vw, 3rem);
                font-weight: 700;
                line-height: 1.2;
                color: #212529;
            }

            /* Cover image */
            /* FIXED: No cropping */
            .blog-cover {
                width: 100%;
                height: auto;
                max-height: none;
                object-fit: contain;
                border-radius: 14px;
                display: block;
            }

            /* Blog content */
            .blog-content {
                font-size: 1.05rem;
                line-height: 1.8;
                color: #343a40;
                word-wrap: break-word;
                overflow-wrap: anywhere;
            }

            /* TinyMCE generated headings */
            .blog-content h1,
            .blog-content h2,
            .blog-content h3,
            .blog-content h4,
            .blog-content h5,
            .blog-content h6 {
                color: #212529;
                font-weight: 700;
                margin-top: 30px;
                margin-bottom: 15px;
            }

            /* Paragraphs */
            .blog-content p {
                margin-bottom: 18px;
            }

            /* Lists */
            .blog-content ul,
            .blog-content ol {
                padding-left: 30px;
                margin-bottom: 20px;
            }

            .blog-content li {
                margin-bottom: 8px;
            }

            /* Links */
            .blog-content a {
                color: #0d6efd;
                text-decoration: underline;
            }

            /* Images inside blog content */
            .blog-content img {
                max-width: 100%;
                height: auto;
                display: block;
                margin: 25px auto;
                border-radius: 10px;
            }

            /* Blockquote */
            .blog-content blockquote {
                border-left: 4px solid #0d6efd;
                padding: 10px 20px;
                margin: 25px 0;
                color: #6c757d;
                background-color: #f1f3f5;
                border-radius: 0 8px 8px 0;
            }

            /* Code */
            .blog-content pre {
                background-color: #212529;
                color: #f8f9fa;
                padding: 18px;
                border-radius: 10px;
                overflow-x: auto;
                margin: 20px 0;
            }

            .blog-content code {
                font-family: monospace;
            }

            /* Tables */
            .blog-content table {
                width: 100%;
                border-collapse: collapse;
                margin: 25px 0;
            }

            .blog-content th,
            .blog-content td {
                border: 1px solid #dee2e6;
                padding: 10px;
                text-align: left;
            }

            .blog-content th {
                background-color: #f1f3f5;
                font-weight: 600;
            }

            /* Author */
            .author-box {
                border: 1px solid #dee2e6;
                border-radius: 14px;
                padding: 18px;
                background-color: white;
                box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
            }

            .author-image {
                width: 50px;
                height: 50px;
                object-fit: cover;
            }

            /* Comments */
            .comment-avatar {
                width: 45px;
                height: 45px;
                object-fit: cover;
                flex-shrink: 0;
            }

            .comment-card {
                border: 1px solid #e9ecef;
                border-radius: 12px;
                padding: 15px;
                margin-bottom: 15px;
                background-color: white;
            }

            .comment-content {
                white-space: pre-wrap;
                word-break: break-word;
                overflow-wrap: anywhere;
            }

            /* Mobile */
            @media (max-width: 576px) {

                .blog-container {
                    padding-left: 15px;
                    padding-right: 15px;
                }

                /* FIXED: Full image on mobile too */
                .blog-cover {
                    width: 100%;
                    height: auto;
                    max-height: none;
                    object-fit: contain;
                    border-radius: 10px;
                }

                .blog-content {
                    font-size: 1rem;
                    line-height: 1.7;
                }

                .author-image {
                    width: 45px;
                    height: 45px;
                }

                .comment-avatar {
                    width: 40px;
                    height: 40px;
                }

                .blog-content table {
                    display: block;
                    overflow-x: auto;
                }

                .comment-card {
                    border: 1px solid #e9ecef;
                    border-radius: 12px;
                    padding: 16px;
                    margin-bottom: 15px;
                    background-color: #fff;
                }

                .comment-avatar {
                    width: 45px;
                    height: 45px;
                    object-fit: cover;
                    flex-shrink: 0;
                }
            }
        </style>

</head>


<body>

    <%- include('./partials/nav.ejs') %>


    <!-- Blog -->
    <main class="container blog-container mt-4 mt-md-5 mb-5">


        <!-- Blog Title -->
        <h1 class="blog-title mb-4">
            <%= blog.title %>
        </h1>


        <!-- Cover Image -->
        <img
            class="blog-cover mb-4"
            src="<%= blog.coverImageURL %>"
            alt="<%= blog.title %>"
        >


        <!-- Blog Content -->
        <div class="mt-4">

            <h3 class="fw-bold mb-3">
                Content of Blog
            </h3>

            <!-- TinyMCE HTML -->
            <div class="blog-content">
                <%- blog.body %>
            </div>

        </div>


        <!-- Author -->
        <div class="author-box mt-5">

            <div class="d-flex align-items-center gap-3">

                <img
                    src="<%= blog.createdBy.profileImageURL %>"
                    alt="<%= blog.createdBy.fullName %>"
                    class="rounded-circle shadow-sm author-image"
                >

                <div>

                    <div class="fw-semibold">
                        <%= blog.createdBy.fullName %>
                    </div>

                    <small class="text-muted">
                        Blog Author
                    </small>

                </div>

            </div>

        </div>


        <!-- Comments -->
        <section class="mt-5">


            <!-- Comments heading -->
            <div class="d-flex align-items-center gap-2 mb-4">

                <h3 class="fw-bold mb-0">
                    Comments
                </h3>

                <span class="badge bg-primary rounded-pill">
                    <%= comments.length %>
                </span>

            </div>


            <!-- Add Comment -->
            <% if (locals.user) { %>

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-body">

                        <form
                            action="/blog/comment/<%= blog._id %>"
                            method="POST"
                        >

                            <div class="mb-3">

                                <label
                                    for="comment"
                                    class="form-label fw-semibold"
                                >
                                    Leave a comment
                                </label>

                                <textarea
                                    id="comment"
                                    name="content"
                                    class="form-control"
                                    rows="3"
                                    placeholder="Write your comment..."
                                    required
                                ></textarea>

                            </div>

                            <button
                                class="btn btn-primary"
                                type="submit"
                            >
                                Add Comment
                            </button>

                        </form>

                    </div>

                </div>


            <% } else { %>

                <div class="alert alert-light border">

                    Please

                    <a
                        href="/user/signin"
                        class="text-decoration-none fw-semibold"
                    >
                        sign in
                    </a>

                    to leave a comment.

                </div>

            <% } %>


            <!-- Comments List -->
            <div class="mt-4">

                <% if (comments.length === 0) { %>

                    <div class="text-center text-muted py-4">

                        <p class="mb-0">
                            No comments yet. Be the first to comment!
                        </p>

                    </div>


                <% } else { %>


                    <% comments.forEach(comment => { %>

                        <div class="comment-card">

                            <div class="d-flex align-items-start gap-3">

                                <!-- Profile Image -->
                                <img
                                    src="<%= comment.createdBy.profileImageURL %>"
                                    alt="<%= comment.createdBy.fullName %>"
                                    class="rounded-circle comment-avatar"
                                >


                                <!-- Comment Details -->
                                <div class="flex-grow-1">

                                    <!-- Username -->
                                    <div class="fw-semibold mb-1">

                                        <%= comment.createdBy.fullName %>

                                    </div>


                                    <!-- Comment -->
                                    <div
                                        style="
                                            text-align: left;
                                            margin: 0;
                                            padding: 0;
                                            line-height: 1.5;
                                            word-break: break-word;
                                            overflow-wrap: anywhere;
                                        "
                                    >

                                        <%= comment.content %>

                                    </div>

                                </div>

                            </div>

                        </div>

                    <% }) %>


                <% } %>

            </div>


        </section>


    </main>


    <%- include('./partials/script.ejs') %>

</body>

</html>