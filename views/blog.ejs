<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head.ejs') %>
    <title><%= blog.title %></title>

    <style>
        .blog-container {
            max-width: 900px;
        }

        .blog-title {
            font-size: clamp(1.8rem, 4vw, 3rem);
            font-weight: 700;
            line-height: 1.2;
        }

        .blog-cover {
            width: 100%;
            max-height: 500px;
            object-fit: cover;
            border-radius: 12px;
        }

        .blog-content {
            font-size: 1.05rem;
            line-height: 1.8;
            white-space: pre-wrap;
            word-wrap: break-word;
            overflow-wrap: anywhere;
        }

        .author-box {
            border: 1px solid #dee2e6;
            border-radius: 12px;
            padding: 15px;
            background-color: #f8f9fa;
        }

        .author-image {
            width: 50px;
            height: 50px;
            object-fit: cover;
        }

        .comment-avatar {
            width: 45px;
            height: 45px;
            object-fit: cover;
            flex-shrink: 0;
        }

        .comment-card {
            border: 1px solid #e9ecef;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .comment-content {
            white-space: pre-wrap;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        @media (max-width: 576px) {
            .blog-container {
                padding-left: 15px;
                padding-right: 15px;
            }

            .blog-cover {
                max-height: 300px;
            }

            .blog-content {
                font-size: 1rem;
            }

            .author-image {
                width: 45px;
                height: 45px;
            }

            .comment-avatar {
                width: 40px;
                height: 40px;
            }
        }
    </style>
</head>

<body>

    <%- include('./partials/nav.ejs') %>


    <!-- Blog -->
    <main class="container blog-container mt-4 mt-md-5">

        <!-- Blog Title -->
        <h1 class="blog-title mb-4">
            <%= blog.title %>
        </h1>


        <!-- Cover Image -->
        <img
            class="blog-cover mb-4"
            src="<%= blog.coverImageURL %>"
            alt="<%= blog.title %>"
        >


        <!-- Blog Content -->
        <div class="mt-4">

            <h3 class="fw-bold mb-3">
                Content of Blog
            </h3>

            <div class="blog-content text-secondary">
                <%= blog.body %>
            </div>

        </div>


        <!-- Author -->
        <div class="author-box mt-5">

            <div class="d-flex align-items-center gap-3">

                <img
                    src="<%= blog.createdBy.profileImageURL %>"
                    alt="<%= blog.createdBy.fullName %>"
                    class="rounded-circle shadow-sm author-image"
                >

                <div>
                    <div class="fw-semibold">
                        <%= blog.createdBy.fullName %>
                    </div>

                    <small class="text-muted">
                        Blog Author
                    </small>
                </div>

            </div>

        </div>


        <!-- Comments -->
        <section class="mt-5 mb-5">

            <div class="d-flex align-items-center gap-2 mb-4">
                <h3 class="fw-bold mb-0">
                    Comments
                </h3>

                <span class="badge bg-primary rounded-pill">
                    <%= comments.length %>
                </span>
            </div>


            <!-- Add Comment -->
            <% if (locals.user) { %>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">

                        <form
                            action="/blog/comment/<%= blog._id %>"
                            method="POST"
                        >

                            <div class="mb-3">

                                <label
                                    for="comment"
                                    class="form-label fw-semibold"
                                >
                                    Leave a comment
                                </label>

                                <textarea
                                    id="comment"
                                    name="content"
                                    class="form-control"
                                    rows="3"
                                    placeholder="Write your comment..."
                                    required
                                ></textarea>

                            </div>

                            <button
                                class="btn btn-primary"
                                type="submit"
                            >
                                Add Comment
                            </button>

                        </form>

                    </div>
                </div>

            <% } else { %>

                <div class="alert alert-light border">
                    Please
                    <a
                        href="/user/signin"
                        class="text-decoration-none fw-semibold"
                    >
                        sign in
                    </a>
                    to leave a comment.
                </div>

            <% } %>


            <!-- Comments List -->
            <div class="mt-4">

                <% if (comments.length === 0) { %>

                    <div class="text-center text-muted py-4">
                        <p class="mb-0">
                            No comments yet. Be the first to comment!
                        </p>
                    </div>

                <% } else { %>

                    <% comments.forEach(comment => { %>

                        <div class="comment-card">

                            <div class="d-flex align-items-start gap-3">

                                <img
                                    src="<%= comment.createdBy.profileImageURL %>"
                                    alt="<%= comment.createdBy.fullName %>"
                                    class="rounded-circle comment-avatar"
                                >

                                <div class="flex-grow-1 min-width-0">

                                    <div class="fw-semibold">
                                        <%= comment.createdBy.fullName %>
                                    </div>

                                    <div class=" mt-1">
                                        <%= comment.content %>
                                    </div>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                <% } %>

            </div>

        </section>

    </main>


    <%- include('./partials/script.ejs') %>

</body>

</html>