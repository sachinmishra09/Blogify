<!DOCTYPE html>
<html lang="en">

<head>

    <%- include('./partials/head.ejs') %>

    <title>Edit Blog</title>

    <!-- TinyMCE -->
    <script
        src="https://cdn.tiny.cloud/1/<%= tinymceApiKey %>/tinymce/8/tinymce.min.js"
        referrerpolicy="origin">
    </script>

    <style>
        body {
            background-color: rgb(120, 197, 225);
        }

        .edit-container {
            max-width: 1000px;
        }

        .edit-card {
            border: none;
            border-radius: 15px;
        }
    </style>

</head>


<body>

    <%- include('./partials/nav.ejs') %>


    <div class="container edit-container mt-4 mb-5">

        <div class="card edit-card shadow">

            <div class="card-body p-4 p-md-5">

                <h2 class="fw-bold mb-4">
                    Edit Blog
                </h2>


                <form
                    action="/blog/edit/<%= blog._id %>"
                    method="POST"
                >

                    <!-- Title -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Title
                        </label>

                        <input
                            type="text"
                            name="title"
                            class="form-control"
                            value="<%= blog.title %>"
                            required
                        >

                    </div>


                    <!-- Blog Body -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Blog Content
                        </label>


                        <!-- TinyMCE textarea -->
                        <textarea
                            id="blogBody"
                            name="body"
                            required
                        ></textarea>


                        <!-- Existing HTML content -->
                        <!-- This is hidden from the user -->
                        <textarea
                            id="existingContent"
                            style="display: none;"
                        ><%= blog.body %></textarea>

                    </div>


                    <!-- Buttons -->

                    <button
                        type="submit"
                        class="btn btn-primary px-4"
                    >
                        Save Changes
                    </button>


                    <a
                        href="/blog/<%= blog._id %>"
                        class="btn btn-secondary px-4 ms-2"
                    >
                        Cancel
                    </a>

                </form>

            </div>

        </div>

    </div>


    <script>

        tinymce.init({

            selector: '#blogBody',

            height: 500,

            menubar: true,

            plugins: [
                'advlist',
                'autolink',
                'lists',
                'link',
                'charmap',
                'preview',
                'anchor',
                'searchreplace',
                'visualblocks',
                'code',
                'fullscreen',
                'insertdatetime',
                'media',
                'table',
                'wordcount'
            ],

            toolbar:
                'undo redo | ' +
                'blocks | ' +
                'bold italic underline strikethrough | ' +
                'forecolor backcolor | ' +
                'alignleft aligncenter alignright alignjustify | ' +
                'bullist numlist | ' +
                'outdent indent | ' +
                'link image media table | ' +
                'removeformat | ' +
                'code fullscreen',


            setup: function (editor) {

                editor.on('init', function () {

                    // Get the existing blog HTML
                    const existingContent =
                        document.getElementById('existingContent').value;

                    // Put the existing HTML into TinyMCE
                    editor.setContent(existingContent);

                });

            },


            content_style: `
                body {
                    font-family: Arial, sans-serif;
                    font-size: 16px;
                    line-height: 1.6;
                    padding: 10px;
                }

                img {
                    max-width: 100%;
                    height: auto;
                }
            `

        });

    </script>


    <%- include('./partials/script.ejs') %>

</body>

</html>







